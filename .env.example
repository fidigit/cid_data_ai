# Application
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=redis://redis:6379/0
ADMIN_API_TOKEN=replace-with-a-long-random-value
ARTIFACTS_DIR=./artifacts
MAX_EXPORT_ROWS=200000
TIMEZONE=Asia/Shanghai

# Authentication. Keep real values only in .env or a secrets manager.
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_NAME=event_ops_session
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD_HASH=

# thread works for a single-process local server; use celery in production.
QUERY_EXECUTION_MODE=thread

# MaxCompute / ODPS. Do not put real credentials in this file.
ODPS_ACCESS_ID=
ODPS_ACCESS_KEY_SECRET=
ODPS_PROJECT=
ODPS_ENDPOINT=
ODPS_TUNNEL_ENDPOINT=

# These values are administrator-controlled, never supplied by a chat user.
DATA_SOURCE_TABLE=
DATA_PARTITION_COLUMN=ds
DATA_EVENT_CODE_COLUMN=cid
DATA_USER_ID_COLUMN=device_id
PARTITION_DATE_FORMAT=%Y%m%d

# Required in production. Generate a long random value and keep it secret.
COST_ESTIMATE_TOKEN_SECRET=
COST_ESTIMATE_TOKEN_TTL_SECONDS=600
COST_ESTIMATE_PRICE_PER_GIB_CNY=0.30

# Enterprise WeCom. Fill in only after choosing "智能机器人 API 模式" or a self-built app.
WECOM_MODE=disabled
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=
